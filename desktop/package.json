{
  "name": "dealforge-desktop",
  "version": "0.1.0",
  "description": "DealForge Desktop — Electron shell wrapping the React frontend",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "build": "tsc && electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": ["crm", "dealforge", "electron"],
  "author": "DealForge Team",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.9.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.dealforge.desktop",
    "productName": "DealForge",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis",
      "sign": false
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
