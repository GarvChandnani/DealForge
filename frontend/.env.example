# ===========================
# Frontend Environment Template
# Copy to frontend/.env (dev) or set in Render dashboard (production)
# ===========================

# Backend API base URL — used by the Axios client
# Development (local):
VITE_API_URL=http://localhost:8000

# Production (Render) — set this in the Render dashboard for the Static Site:
# VITE_API_URL=https://dealforge-backend.onrender.com
