# ===========================
# Backend Environment Template
# Copy to backend/.env
# ===========================

APP_ENV=development
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DEALFORGE_DEMO_PASSWORD=

# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./dealforge.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/dealforge

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json

# LLM (used by the agents module via LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LITELLM_DEFAULT_MODEL=gpt-4o-mini
