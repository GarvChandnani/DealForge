# ===========================
# DealForge — Root Environment Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ===========================

# --- App ---
APP_ENV=development          # development | staging | production
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DEALFORGE_DEMO_PASSWORD=

# --- Database ---
# SQLite (default for local dev — no extra setup needed):
DATABASE_URL=sqlite+aiosqlite:///./dealforge.db
# PostgreSQL (production — Render provides this automatically via fromDatabase):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/dealforge

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins.
# Production: set to your Render frontend URL, e.g.:
# ALLOWED_ORIGINS=https://dealforge-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console    # console | json  (use json in production)

# --- LLM / AI ---
# LiteLLM routes calls based on model name prefix.
# Provide only the keys for providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LITELLM_DEFAULT_MODEL=gpt-4o-mini
AI_MOCK_MODE=false

# --- Frontend (set in Render dashboard for static site) ---
VITE_API_URL=http://localhost:8000
# Production: VITE_API_URL=https://dealforge-backend.onrender.com
